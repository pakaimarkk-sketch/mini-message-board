<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Üzenőfal</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Üzenőfal kezdőlap"><span class="brand-mark">✳</span> Üzenőfal</a>
        <a class="button button-small" href="/new">+ Új üzenet</a>
      </header>

      <main>
        <section class="hero">
          <div>
            <p class="eyebrow">Közös tér</p>
            <h1>Gondolatok, egy helyen.</h1>
            <p class="intro">Olvasd el, mit írtak mások, vagy hagyj itt egy üzenetet.</p>
          </div>
          <span class="count"><%= messages.length %> üzenet</span>
        </section>

        <section class="message-section" aria-labelledby="messages-title">
          <div class="section-heading">
            <h2 id="messages-title">Üzenetek</h2>
            <span>Legfrissebb beszélgetések</span>
          </div>

          <% if (messages.length === 0) { %>
            <div class="empty-state">
              <span class="empty-icon" aria-hidden="true">✳</span>
              <h3>Még nincs üzenet</h3>
              <p>Írd meg az elsőt, és indítsd el a beszélgetést.</p>
              <a class="button" href="/new">Írok egy üzenetet</a>
            </div>
          <% } else { %>
            <ul class="message-list">
              <% messages.forEach((message) => { %>
                <li class="message-card">
                  <div class="message-meta">
                    <span class="avatar" aria-hidden="true"><%= message.user.charAt(0).toUpperCase() %></span>
                    <div>
                      <strong class="author"><%= message.user %></strong>
                      <time class="date"><%= message.added.toLocaleString("hu-HU") %></time>
                    </div>
                  </div>
                  <p class="message-preview"><%= message.text %></p>
                  <a class="text-link" href="/messages/<%= message.id %>" aria-label="<%= message.user %> üzenetének megnyitása">Üzenet megnyitása <span aria-hidden="true">→</span></a>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </section>
      </main>

      <footer class="site-footer">Mini Message Board</footer>
    </div>
  </body>
</html>
