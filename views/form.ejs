<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Új üzenet · Üzenőfal</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Üzenőfal kezdőlap"
          ><span class="brand-mark">✳</span> Üzenőfal</a
        >
        <a class="header-link" href="/">Összes üzenet</a>
      </header>

      <main class="narrow-main">
        <a class="back-link" href="/">← Vissza az üzenetekhez</a>
        <div class="page-heading">
          <p class="eyebrow">Új bejegyzés</p>
          <h1>Mit szeretnél megosztani?</h1>
          <p class="intro">Írd meg az üzeneted, és megjelenik az üzenőfalon.</p>
        </div>

        <form class="form-card" method="POST" action="/new">
          <div class="field">
            <label for="user">Neved</label>
            <input
              type="text"
              id="user"
              name="user"
              placeholder="Hogy szólíthatunk?"
              maxlength="60"
              required
              autocomplete="name"
            />
          </div>
          <div class="field">
            <label for="text">Üzeneted</label>
            <textarea
              id="text"
              name="text"
              placeholder="Írd ide az üzeneted..."
              rows="7"
              maxlength="2000"
              required
            ></textarea>
          </div>
          <div class="form-actions">
            <a class="secondary-link" href="/">Mégsem</a>
            <button class="button" type="submit">
              Üzenet küldése <span aria-hidden="true">→</span>
            </button>
          </div>
        </form>
      </main>
      <footer class="site-footer">Mini Message Board</footer>
    </div>
  </body>
</html>
